<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 12+ Bluetooth permissions. neverForLocation lets us scan
         without holding a location permission, which we genuinely do not
         need: we filter by device name, not by position. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Pre-Android 12 equivalents. Legacy scanning is gated on location. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Used by the bridge source when running on the emulator. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BLE is required for the real device path, but the app still runs on
         an emulator over the bridge, so do not make it a hard install gate. -->
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="XIAO IMU"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.XiaoImu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="XIAO IMU"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
